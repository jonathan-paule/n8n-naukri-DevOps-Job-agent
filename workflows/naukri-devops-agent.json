    {
      "parameters": {
        "jsCode": "// n8n Code Node - JavaScript\nconst items = $input.all();\nconst cleanedJobs = [];\n\n// Limit to the first 5 jobs to protect API quotas during execution\nconst limitedItems = items.slice(0, 5);\n\nfor (const item of limitedItems) {\n  const data = item.json;\n  \n  // Extract key details with fallbacks\n  cleanedJobs.push({\n    json: {\n      jobId: data.jobId || data.id || `job_${Math.random().toString(36).substr(2, 9)}`,\n      title: data.title || data.jobTitle || 'N/A',\n      company: data.companyName || data.company || 'N/A',\n      location: Array.isArray(data.location) ? data.location.join(', ') : (data.location || 'N/A'),\n      experience: data.experience || '1-2 years',\n      jdText: (data.description || data.jobDescription || data.snippet || '').replace(/<[^>]*>?/gm, '').trim(),\n      applyUrl: data.url || data.jobUrl || '',\n      postedDate: data.postedDate || new Date().toISOString().split('T')[0]\n    }\n  });\n}\n\nreturn cleanedJobs;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        256
      ],
      "id": "38c941bb-becb-4f8e-ae74-2882cccfa9f9",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert DevOps Technical Recruiter.\n\nCandidate Profile:\n- Experience: 1+ years in AWS Cloud & DevOps Engineering.\n- Core Skills: AWS (EC2, S3, VPC, IAM, RDS, Lambda, CloudWatch), Terraform, Docker, Kubernetes, CI/CD Pipelines (Jenkins / GitHub Actions), Python, Shell Scripting, Linux administration.\n- Preferred Seniority: Associate / Junior / Mid-level Cloud or DevOps Engineer.\n\nEvaluate the following Job Listing:\nTitle: {{ $json.title }}\nCompany: {{ $json.company }}\nLocation: {{ $json.location }}\nJob Description:\n{{ $json.jdText }}\n\nAnalyze the alignment and respond strictly in valid JSON format:\n{\n  \"matchScore\": <integer between 0 and 100>,\n  \"seniorityFit\": \"<Match / Too Senior / Too Junior>\",\n  \"matchingSkills\": [\"skill1\", \"skill2\"],\n  \"missingSkills\": [\"skill1\", \"skill2\"],\n  \"reasoning\": \"<1-2 sentence summary of why this is or isn't a good fit>\"\n}",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1184,
        -128
      ],
      "id": "2c61e6f1-1164-4c82-9f64-8012285cf753",
      "name": "AI Agent",
      "retryOnFail": false,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// n8n Code Node - JavaScript1\nconst items = $input.all();\nconst filteredJobs = [];\n\nfor (const item of items) {\n  let aiData = item.json.output;\n  \n  // Parse if it's returned as a string\n  if (typeof aiData === 'string') {\n    try {\n      // Clean potential markdown code blocks if present\n      aiData = JSON.parse(aiData.replace(/```json\\n?|\\n?```/g, ''));\n    } catch (e) {\n      continue; // Skip if parsing fails\n    }\n  }\n\n  // Filter jobs matching your 1+ years experience and fit criteria (e.g., matchScore >= 50 or 60)\n  // Let's filter for matches where matchScore is >= 50 to see viable roles\n  if (aiData && aiData.matchScore >= 50) {\n    filteredJobs.push({\n      json: {\n        matchScore: aiData.matchScore,\n        seniorityFit: aiData.seniorityFit,\n        matchingSkills: aiData.matchingSkills,\n        missingSkills: aiData.missingSkills,\n        reasoning: aiData.reasoning\n      }\n    });\n  }\n}\n\nreturn filteredJobs;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
